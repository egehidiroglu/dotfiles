// ~/.config/fastfetch/config.jsonc — neon system info banner
// `fastfetch` printed at the top of every new shell. Comment out the line in zshrc to disable.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": { "top": 1, "right": 2 },
    "color": {
      "1": "magenta",
      "2": "blue"
    }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 12 },
    "color": {
      "keys": "magenta",
      "title": "cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}{at-symbol}{host-name}",
      "color": { "user": "magenta", "at": "white", "host": "cyan" }
    },
    "separator",
    { "type": "os",        "key": "  os" },
    { "type": "kernel",    "key": "  kernel" },
    { "type": "host",      "key": "  host" },
    { "type": "uptime",    "key": "  uptime" },
    { "type": "packages",  "key": "  pkgs" },
    { "type": "shell",     "key": "  shell" },
    { "type": "terminal",  "key": "  term" },
    { "type": "cpu",       "key": "  cpu" },
    { "type": "gpu",       "key": "  gpu" },
    { "type": "memory",    "key": "  ram" },
    { "type": "disk",      "key": "  disk" },
    { "type": "localip",   "key": "  ip"     },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
